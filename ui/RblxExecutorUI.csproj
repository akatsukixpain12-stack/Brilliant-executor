<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>Syntax Executor</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Description>Brilliant Executor - Premium Roblox Execution Engine with ScriptBlox Integration</Description>
    <Company>Brilliant Team</Company>
    <Product>Brilliant Executor</Product>
    <Copyright>© 2026 Brilliant Team</Copyright>
    <Version>2.0.0.0</Version>
    <FileVersion>2.0.0.0</FileVersion>
    <AssemblyTitle>Brilliant Executor</AssemblyTitle>
    <Trademark>Brilliant</Trademark>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>false</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishReadyToRun>true</PublishReadyToRun>
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AvalonEdit" Version="6.3.1.120" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Lua.xshd">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- Copy Syntax.dll from multiple possible build locations -->
  <Target Name="CopyNativeDll" AfterTargets="Build">
    <Copy SourceFiles="$(ProjectDir)..\build\Release\Syntax.dll" DestinationFolder="$(OutDir)" Condition="Exists('$(ProjectDir)..\build\Release\Syntax.dll')" />
    <Copy SourceFiles="$(ProjectDir)..\build\Release\SyntaxAPI.dll" DestinationFolder="$(OutDir)" DestinationFiles="$(OutDir)Syntax.dll" Condition="Exists('$(ProjectDir)..\build\Release\SyntaxAPI.dll')" />
    <Copy SourceFiles="$(ProjectDir)bin\$(Configuration)\net10.0-windows\win-x64\Syntax.dll" DestinationFolder="$(OutDir)" Condition="Exists('$(ProjectDir)bin\$(Configuration)\net10.0-windows\win-x64\Syntax.dll')" />
    <Copy SourceFiles="$(ProjectDir)..\publish\Syntax.dll" DestinationFolder="$(OutDir)" Condition="Exists('$(ProjectDir)..\publish\Syntax.dll')" />
    <Warning Text="Syntax.dll not found — UI will run but DLL calls will fail until you build the C++ project (cmake -B build -A x64 &amp;&amp; cmake --build build --config Release)." Condition="!Exists('$(OutDir)Syntax.dll')" />
  </Target>

</Project>