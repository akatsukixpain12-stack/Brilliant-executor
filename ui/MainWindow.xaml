<Window x:Class="RblxExecutorUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:avalonEdit="http://icsharpcode.net/sharpdevelop/avalonedit"
        Title="Evo Executor" Height="620" Width="1100"
        Background="Transparent" Foreground="#E0E0E0"
        WindowStyle="None" AllowsTransparency="True"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI, 'Cascadia Code', 'Fira Code', monospace"
        ResizeMode="CanResize"
        MinHeight="520" MinWidth="880">

    <Window.Resources>

        <!-- ============================================================ -->
        <!--  CORE COLOR PALETTE - Neon Cyberpunk / Dark Glass              -->
        <!-- ============================================================ -->
        <Color x:Key="BgMain">#0A0E1A</Color>
        <Color x:Key="BgSidebar">#070B14</Color>
        <Color x:Key="BgSurface">#0D1220</Color>
        <Color x:Key="BgCard">#111827</Color>
        <Color x:Key="BgHover">#1A2235</Color>
        <Color x:Key="BgToolbar">#0B1020</Color>
        <Color x:Key="BgEditor">#080C18</Color>
        <Color x:Key="BorderDim">#1E2A45</Color>
        <Color x:Key="BorderMid">#2D3F66</Color>
        <Color x:Key="BorderBright">#4A6FA5</Color>

        <!-- Accent: Cyan/Teal Neon -->
        <Color x:Key="AccentPrimary">#00E5FF</Color>
        <Color x:Key="AccentSecondary">#00B4D8</Color>
        <Color x:Key="AccentGlow">#0077B6</Color>
        <Color x:Key="AccentGreen">#00F593</Color>
        <Color x:Key="AccentPurple">#A855F7</Color>
        <Color x:Key="AccentOrange">#FF8C00</Color>
        <Color x:Key="AccentRed">#FF3B5C</Color>

        <Color x:Key="TextPrimary">#F0F4FF</Color>
        <Color x:Key="TextSecondary">#94A3B8</Color>
        <Color x:Key="TextDim">#475569</Color>
        <Color x:Key="TextMuted">#334155</Color>

        <!-- Brushes -->
        <SolidColorBrush x:Key="BrushAccent" Color="{StaticResource AccentPrimary}"/>
        <SolidColorBrush x:Key="BrushAccentSec" Color="{StaticResource AccentSecondary}"/>
        <SolidColorBrush x:Key="BrushGreen" Color="{StaticResource AccentGreen}"/>
        <SolidColorBrush x:Key="BrushPurple" Color="{StaticResource AccentPurple}"/>
        <SolidColorBrush x:Key="BrushOrange" Color="{StaticResource AccentOrange}"/>
        <SolidColorBrush x:Key="BrushRed" Color="{StaticResource AccentRed}"/>
        <SolidColorBrush x:Key="BrushPrimary" Color="{StaticResource TextPrimary}"/>
        <SolidColorBrush x:Key="BrushSecondary" Color="{StaticResource TextSecondary}"/>
        <SolidColorBrush x:Key="BrushDim" Color="{StaticResource TextDim}"/>
        <SolidColorBrush x:Key="BrushMuted" Color="{StaticResource TextMuted}"/>

        <!-- ============================================================ -->
        <!--  GRADIENT BRUSHES                                              -->
        <!-- ============================================================ -->
        <LinearGradientBrush x:Key="GradSidebar" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#070B14" Offset="0.0"/>
            <GradientStop Color="#0A0E1A" Offset="0.5"/>
            <GradientStop Color="#070B14" Offset="1.0"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="GradTitlebar" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#0A0E1A" Offset="0.0"/>
            <GradientStop Color="#0D1220" Offset="0.5"/>
            <GradientStop Color="#0A0E1A" Offset="1.0"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="GradAccent" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#00E5FF" Offset="0.0"/>
            <GradientStop Color="#A855F7" Offset="0.5"/>
            <GradientStop Color="#00F593" Offset="1.0"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="GradCardHover" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#111827" Offset="0.0"/>
            <GradientStop Color="#1A2235" Offset="1.0"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="GradBtnExecute" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#00E5FF" Offset="0.0"/>
            <GradientStop Color="#00B4D8" Offset="1.0"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="GradBtnDanger" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#FF3B5C" Offset="0.0"/>
            <GradientStop Color="#E6294A" Offset="1.0"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="GradBtnAttach" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#00F593" Offset="0.0"/>
            <GradientStop Color="#00C47D" Offset="1.0"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="GradBtnDefault" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#1E2A45" Offset="0.0"/>
            <GradientStop Color="#2D3F66" Offset="1.0"/>
        </LinearGradientBrush>

        <!-- ============================================================ -->
        <!--  GLOBAL STYLES                                                -->
        <!-- ============================================================ -->

        <!-- Scrollbar - Sleek neon style -->
        <Style x:Key="NeonScrollThumb" TargetType="Thumb">
            <Setter Property="Background" Value="#2D3F66"/>
            <Setter Property="Width" Value="4"/>
            <Setter Property="MinWidth" Value="4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4"
                                Margin="2,0" Width="4" HorizontalAlignment="Center"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="NeonScrollBar" TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="{TemplateBinding Background}">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource NeonScrollThumb}"/>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Sidebar nav item - Glass effect -->
        <Style x:Key="NavItem" TargetType="RadioButton">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource BrushDim}"/>
            <Setter Property="GroupName" Value="NavGroup"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bg" Background="Transparent" CornerRadius="8" Padding="14,0" Margin="6,0">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#151E30"/>
                                <Setter Property="Foreground" Value="{StaticResource BrushSecondary}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#111827"/>
                                <Setter TargetName="bg" Property="BorderBrush" Value="#2D3F66"/>
                                <Setter TargetName="bg" Property="BorderThickness" Value="1"/>
                                <Setter Property="Foreground" Value="{StaticResource BrushAccent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Secondary nav items (bottom) -->
        <Style x:Key="NavItemSmall" TargetType="RadioButton" BasedOn="{StaticResource NavItem}">
            <Setter Property="Height" Value="36"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <!-- Tool button - Glassmorphism -->
        <Style x:Key="ToolBtn" TargetType="Button">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Background" Value="{StaticResource GradBtnDefault}"/>
            <Setter Property="Foreground" Value="{StaticResource BrushSecondary}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#1E2A45"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <Border.Effect>
                                <DropShadowEffect Color="#00E5FF" BlurRadius="4" ShadowDepth="0" Opacity="0"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#1E2A45"/>
                                <Setter TargetName="bg" Property="BorderBrush" Value="#4A6FA5"/>
                                <Setter Property="Foreground" Value="{StaticResource BrushPrimary}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#0D1220"/>
                                <Setter TargetName="bg" Property="BorderBrush" Value="#00E5FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Execute button - neon cyan -->
        <Style x:Key="BtnExecute" TargetType="Button" BasedOn="{StaticResource ToolBtn}">
            <Setter Property="Background" Value="{StaticResource GradBtnExecute}"/>
            <Setter Property="Foreground" Value="#0A0E1A"/>
            <Setter Property="BorderBrush" Value="#00E5FF"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <!-- Attach button - neon green -->
        <Style x:Key="BtnAttach" TargetType="Button" BasedOn="{StaticResource ToolBtn}">
            <Setter Property="Background" Value="{StaticResource GradBtnAttach}"/>
            <Setter Property="Foreground" Value="#0A0E1A"/>
            <Setter Property="BorderBrush" Value="#00F593"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <!-- Kill button - neon red -->
        <Style x:Key="BtnDanger" TargetType="Button" BasedOn="{StaticResource ToolBtn}">
            <Setter Property="Background" Value="{StaticResource GradBtnDanger}"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#FF3B5C"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <!-- Script Tab -->
        <Style x:Key="ScriptTab" TargetType="RadioButton">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="12,0,6,0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource BrushDim}"/>
            <Setter Property="GroupName" Value="ScriptTabGroup"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bg" Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}"
                                BorderBrush="#1A2235" BorderThickness="0,0,1,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock x:Name="lbl" Text="{TemplateBinding Content}"
                                           Foreground="{TemplateBinding Foreground}"
                                           VerticalAlignment="Center" FontSize="12"/>
                                <Button x:Name="closeBtn" Content="×" Width="18" Height="18"
                                        Background="Transparent" BorderThickness="0"
                                        Foreground="{StaticResource BrushMuted}" FontSize="12"
                                        Margin="6,0,0,0" Cursor="Hand" Padding="0"
                                        Click="TabClose_Click" Tag="{TemplateBinding Tag}">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="cbg" Background="Transparent" CornerRadius="4">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="cbg" Property="Background" Value="#2D3F66"/>
                                                    <Setter Property="Foreground" Value="{StaticResource BrushPrimary}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#151E30"/>
                                <Setter Property="Foreground" Value="{StaticResource BrushSecondary}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#111827"/>
                                <Setter Property="Foreground" Value="{StaticResource BrushAccent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Window chrome button -->
        <Style x:Key="ChromeBtn" TargetType="Button">
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource BrushDim}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="{TemplateBinding Background}" CornerRadius="4" Margin="2,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#1A2235"/>
                                <Setter Property="Foreground" Value="{StaticResource BrushPrimary}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ScrollViewer style -->
        <Style x:Key="NeonScrollViewer" TargetType="ScrollViewer">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollViewer">
                        <Grid>
                            <ScrollContentPresenter CanContentScroll="True" Margin="0,0,8,0"/>
                            <ScrollBar x:Name="PART_VerticalScrollBar"
                                       Style="{StaticResource NeonScrollBar}"
                                       Value="{TemplateBinding VerticalOffset}"
                                       Maximum="{TemplateBinding ScrollableHeight}"
                                       ViewportSize="{TemplateBinding ViewportHeight}"
                                       Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"
                                       HorizontalAlignment="Right" Width="8"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ScriptHub Card -->
        <Style x:Key="HubCard" TargetType="Border">
            <Setter Property="Background" Value="#111827"/>
            <Setter Property="BorderBrush" Value="#1E2A45"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="16,14"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource GradCardHover}"/>
                    <Setter Property="BorderBrush" Value="#4A6FA5"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ScriptBlox Hub Card -->
        <Style x:Key="BloxCard" TargetType="Border">
            <Setter Property="Background" Value="#0F1525"/>
            <Setter Property="BorderBrush" Value="#1E2A45"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="16,14"/>
            <Setter Property="Margin" Value="0,0,10,10"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#151E30"/>
                    <Setter Property="BorderBrush" Value="#00E5FF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ============================================================ -->
        <!--  ANIMATION KEYFRAMES                                          -->
        <!-- ============================================================ -->
        <Storyboard x:Key="PulseAccent">
            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                             From="0.4" To="1" Duration="0:0:1.5"
                             AutoReverse="True" RepeatBehavior="Forever"/>
        </Storyboard>
    </Window.Resources>

    <!-- ============================================================ -->
    <!--  ROOT - Outer drop shadow with glow                            -->
    <!-- ============================================================ -->
    <Border Margin="10" CornerRadius="12" ClipToBounds="False"
            MouseLeftButtonDown="TitleBar_MouseDown">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="40" ShadowDepth="8" Opacity="0.8" Direction="270"/>
        </Border.Effect>
        <Border x:Name="MainBorder"
                Background="#0A0E1A"
                BorderBrush="#1E2A45"
                BorderThickness="1"
                CornerRadius="12"
                ClipToBounds="True">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="195"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- ============================================================ -->
                <!--  SIDEBAR                                                       -->
                <!-- ============================================================ -->
                <Border Grid.Column="0"
                        Background="{StaticResource GradSidebar}"
                        BorderBrush="#1A2235" BorderThickness="0,0,1,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="60"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Logo -->
                        <Border Grid.Row="0" Padding="18,0"
                                BorderBrush="#1A2235" BorderThickness="0,0,0,1">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <!-- Animated neon logo icon -->
                                <Grid Width="22" Height="22" Margin="0,0,10,0">
                                    <Path Data="M 3,15 Q 9,1 15,3 Q 11,9 9,9 Q 7,15 3,15 Z M 9,9 L 3,15"
                                          Stroke="{StaticResource BrushAccent}" StrokeThickness="1.8"
                                          Fill="Transparent" Stretch="Uniform"
                                          StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                    <Path Data="M 3,15 Q 9,1 15,3 Q 11,9 9,9 Q 7,15 3,15 Z M 9,9 L 3,15"
                                          Stroke="{StaticResource BrushPurple}" StrokeThickness="1.8"
                                          Fill="Transparent" Stretch="Uniform" Opacity="0.4"
                                          StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                          RenderTransformOrigin="0.5,0.5">
                                        <Path.RenderTransform>
                                            <ScaleTransform ScaleX="1.3" ScaleY="1.3"/>
                                        </Path.RenderTransform>
                                    </Path>
                                </Grid>
                                <TextBlock Text="SYNTAX" Foreground="{StaticResource BrushPrimary}"
                                           FontSize="16" FontWeight="Bold"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- Nav items -->
                        <StackPanel Grid.Row="1" Margin="8,16,8,0">
                            <!-- Dashboard -->
                            <RadioButton Style="{StaticResource NavItem}"
                                         Checked="Tab_Dashboard" Margin="0,0,0,3">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="M 0,8 L 8,0 L 16,8 L 16,16 L 10,16 L 10,10 L 6,10 L 6,16 L 0,16 Z"
                                          Fill="Transparent"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                          StrokeThickness="1.5" Stretch="Uniform" Width="16" Height="16"
                                          StrokeLineJoin="Round" Margin="0,0,12,0"/>
                                    <TextBlock Text="Dashboard" VerticalAlignment="Center" FontSize="13"/>
                                </StackPanel>
                            </RadioButton>

                            <!-- Executor -->
                            <RadioButton Style="{StaticResource NavItem}"
                                         IsChecked="True" Checked="Tab_Editor" Margin="0,0,0,3">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="M 2,14 L 8,8 L 2,2 M 10,14 L 16,14"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                          StrokeThickness="2" Stretch="Uniform" Width="16" Height="16"
                                          StrokeEndLineCap="Round" StrokeLineJoin="Round" Margin="0,0,12,0"/>
                                    <TextBlock Text="Editor" VerticalAlignment="Center" FontSize="13"/>
                                </StackPanel>
                            </RadioButton>

                            <!-- ScriptBlox Hub -->
                            <RadioButton Style="{StaticResource NavItem}"
                                         Checked="Tab_ScriptHub" Margin="0,0,0,3">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="M 2,3 L 14,3 M 2,7 L 14,7 M 2,11 L 14,11 M 2,15 L 14,15"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                          StrokeThickness="1.5" Stretch="Uniform" Width="16" Height="16"
                                          StrokeEndLineCap="Round" Margin="0,0,12,0"/>
                                    <TextBlock Text="ScriptBlox" VerticalAlignment="Center" FontSize="13"/>
                                </StackPanel>
                            </RadioButton>

                            <!-- Client Manager -->
                            <RadioButton Style="{StaticResource NavItem}"
                                         Checked="Tab_Clients" Margin="0,0,0,3">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="M 8,7 A 3.5,3.5 0 1,0 8,0 A 3.5,3.5 0 1,0 8,7 Z M 1,15 C 1,10 15,10 15,15"
                                          Fill="Transparent"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                          StrokeThickness="1.5" Stretch="Uniform" Width="16" Height="16"
                                          StrokeEndLineCap="Round" Margin="0,0,12,0"/>
                                    <TextBlock Text="Clients" VerticalAlignment="Center" FontSize="13"/>
                                </StackPanel>
                            </RadioButton>
                        </StackPanel>

                        <!-- Bottom section - Settings -->
                        <StackPanel Grid.Row="2" Margin="8,0,8,14">
                            <Border Height="1" Background="#1A2235" Margin="6,0,6,10"/>
                            <RadioButton Style="{StaticResource NavItemSmall}"
                                         Checked="Tab_Settings" Margin="0,0,0,2">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="M 8,5 A 3,3 0 1,0 8,11 A 3,3 0 1,0 8,5 Z M 8,0 L 8,3 M 8,13 L 8,16 M 0,8 L 3,8 M 13,8 L 16,8 M 2.3,2.3 L 4.4,4.4 M 11.6,11.6 L 13.7,13.7 M 13.7,2.3 L 11.6,4.4 M 4.4,11.6 L 2.3,13.7"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                          StrokeThickness="1.5" Stretch="Uniform" Width="14" Height="14"
                                          StrokeEndLineCap="Round" Margin="0,0,12,0"/>
                                    <TextBlock Text="Settings" VerticalAlignment="Center" FontSize="12"/>
                                </StackPanel>
                            </RadioButton>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ============================================================ -->
                <!--  MAIN CONTENT AREA                                            -->
                <!-- ============================================================ -->
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="32"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Title bar -->
                    <Border Grid.Row="0"
                            Background="{StaticResource GradTitlebar}"
                            BorderBrush="#1A2235" BorderThickness="0,0,0,1">
                        <Grid>
                            <!-- Connection indicator dot -->
                            <Ellipse x:Name="StatusDot" Width="6" Height="6"
                                     Fill="#334155" HorizontalAlignment="Left"
                                     VerticalAlignment="Center" Margin="14,0,0,0">
                                <Ellipse.Effect>
                                    <DropShadowEffect Color="#00E5FF" BlurRadius="6" ShadowDepth="0" Opacity="0"/>
                                </Ellipse.Effect>
                            </Ellipse>
                            <TextBlock x:Name="WindowTitle" Text="Evo Executor"
                                       Foreground="{StaticResource BrushMuted}" FontSize="11"
                                       VerticalAlignment="Center" HorizontalAlignment="Left"
                                       Margin="26,0,0,0"/>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                        VerticalAlignment="Center" Margin="0,0,4,0">
                                <Button Style="{StaticResource ChromeBtn}" Content="─"
                                        Click="Minimize_Click" ToolTip="Minimize"/>
                                <Button Style="{StaticResource ChromeBtn}" Content="□"
                                        Click="Maximize_Click" ToolTip="Maximize"/>
                                <Button x:Name="CloseBtn" Style="{StaticResource ChromeBtn}" Content="✕"
                                        Click="Close_Click" ToolTip="Close"
                                        Foreground="{StaticResource BrushDim}"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Page container -->
                    <Grid Grid.Row="1">

                        <!-- ================================================ -->
                        <!--  EXECUTOR PAGE                                    -->
                        <!-- ================================================ -->
                        <Grid x:Name="ViewEditor" Visibility="Visible">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="34"/>
                                <RowDefinition Height="44"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="26"/>
                            </Grid.RowDefinitions>

                            <!-- Tab bar -->
                            <Border Grid.Row="0" Background="#0B1020"
                                    BorderBrush="#1A2235" BorderThickness="0,0,0,1">
                                <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                              VerticalScrollBarVisibility="Disabled"
                                              HorizontalAlignment="Left" VerticalAlignment="Stretch"
                                              Style="{StaticResource NeonScrollViewer}">
                                    <StackPanel x:Name="TabBarPanel" Orientation="Horizontal"
                                                VerticalAlignment="Stretch"/>
                                </ScrollViewer>
                            </Border>

                            <!-- Toolbar -->
                            <Border Grid.Row="1" Background="#0D1220"
                                    BorderBrush="#1A2235" BorderThickness="0,0,0,1"
                                    Padding="10,0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <!-- Execute -->
                                    <Button Style="{StaticResource BtnExecute}" Click="Execute_Click">
                                         <StackPanel Orientation="Horizontal">
                                            <Path Data="M 1,0 L 9,5 L 1,10 Z" Fill="#0A0E1A"
                                                  Stretch="Uniform" Width="10" Height="12"/>
                                            <TextBlock Text="Execute" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <!-- Clear -->
                                    <Button Style="{StaticResource ToolBtn}" Click="Clear_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="M 3,4 L 13,4 M 6,4 L 6,2 L 10,2 L 10,4 M 4,4 L 4,13 L 12,13 L 12,4"
                                                  Stroke="{StaticResource BrushSecondary}" StrokeThickness="1.2" Fill="Transparent"
                                                  Stretch="Uniform" Width="11" Height="13"
                                                  StrokeLineJoin="Round" StrokeEndLineCap="Round"/>
                                            <TextBlock Text="Clear" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <!-- Separator -->
                                    <Rectangle Width="1" Margin="4,4" Fill="#1A2235"/>
                                    <!-- Attach -->
                                    <Button Style="{StaticResource BtnAttach}" Click="Attach_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="M 4,8 L 8,4 L 12,8 M 8,4 L 8,14 M 2,14 L 14,14"
                                                  Stroke="#0A0E1A" StrokeThickness="1.8" Fill="Transparent"
                                                  Stretch="Uniform" Width="12" Height="13"
                                                  StrokeLineJoin="Round" StrokeEndLineCap="Round"/>
                                            <TextBlock Text="Attach" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <!-- Kill Roblox -->
                                    <Button Style="{StaticResource BtnDanger}" Click="KillRoblox_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="M 2,2 L 12,12 M 12,2 L 2,12"
                                                  Stroke="#FFFFFF" StrokeThickness="1.8"
                                                  Stretch="Uniform" Width="10" Height="10"
                                                  StrokeEndLineCap="Round"/>
                                            <TextBlock Text="Kill" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <!-- Separator -->
                                    <Rectangle Width="1" Margin="4,4" Fill="#1A2235"/>
                                    <!-- Save -->
                                    <Button Style="{StaticResource ToolBtn}" Click="Save_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="M 2,2 L 12,2 L 12,13 L 2,13 Z M 4,2 L 4,5 L 10,5 L 10,2 M 3,13 L 3,8 L 11,8 L 11,13"
                                                  Stroke="{StaticResource BrushSecondary}" StrokeThickness="1.2" Fill="Transparent"
                                                  Stretch="Uniform" Width="11" Height="13"
                                                  StrokeLineJoin="Round"/>
                                            <TextBlock Text="Save" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <!-- Open -->
                                    <Button Style="{StaticResource ToolBtn}" Click="Open_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="M 1,4 L 6,4 L 8,6 L 14,6 L 14,13 L 1,13 Z"
                                                  Stroke="{StaticResource BrushSecondary}" StrokeThickness="1.2" Fill="Transparent"
                                                  Stretch="Uniform" Width="13" Height="11"
                                                  StrokeLineJoin="Round"/>
                                            <TextBlock Text="Open" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Border>

                            <!-- AvalonEdit Editor -->
                            <avalonEdit:TextEditor Grid.Row="2"
                                x:Name="Editor"
                                FontFamily="'Cascadia Code', 'Fira Code', Consolas, 'Courier New', monospace"
                                FontSize="13"
                                Background="#080C18"
                                Foreground="#D0D8E8"
                                ShowLineNumbers="True"
                                LineNumbersForeground="#1E2A45"
                                Padding="4,6,8,6"/>

                            <!-- Status bar -->
                            <Border Grid.Row="3" Background="#070B14"
                                    BorderBrush="#1A2235" BorderThickness="0,1,0,0"
                                    Padding="14,0">
                                <Grid>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Ellipse x:Name="StatusIndicator" Width="5" Height="5"
                                                 Fill="#334155" Margin="0,0,8,0"/>
                                        <TextBlock x:Name="InjectionStatus" Text="NOT ATTACHED"
                                                   Foreground="{StaticResource BrushDim}" FontSize="10.5"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock x:Name="StatusRight" Text="⚡ v1.0"
                                               Foreground="{StaticResource BrushMuted}" FontSize="10.5"
                                               VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- ================================================ -->
                        <!--  DASHBOARD PAGE                                   -->
                        <!-- ================================================ -->
                        <Grid x:Name="ViewDashboard" Visibility="Collapsed">
                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                          Style="{StaticResource NeonScrollViewer}"
                                          Padding="30,25">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,24">
                                        <TextBlock Text="Dashboard" Foreground="{StaticResource BrushPrimary}"
                                                   FontSize="22" FontWeight="Bold" VerticalAlignment="Center"/>
                                        <Border Background="#111827" BorderBrush="#1E2A45"
                                                BorderThickness="1" CornerRadius="12" Padding="10,4"
                                                Margin="12,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="LIVE" Foreground="{StaticResource BrushGreen}"
                                                       FontSize="9" FontWeight="Bold"/>
                                        </Border>
                                    </StackPanel>

                                    <!-- Info card -->
                                    <Border Background="#111827" BorderBrush="#1E2A45"
                                            BorderThickness="1" CornerRadius="12" Padding="22,18"
                                            Margin="0,0,0,16">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Width="44" Height="44"
                                                    CornerRadius="10" Background="#0D1220"
                                                    BorderBrush="#1E2A45" BorderThickness="1"
                                                    VerticalAlignment="Center" Margin="0,0,16,0">
                                                <Path Data="M 3,15 Q 9,1 15,3 Q 11,9 9,9 Q 7,15 3,15 Z M 9,9 L 3,15"
                                                      Stroke="{StaticResource BrushAccent}" StrokeThickness="1.5"
                                                      Fill="Transparent" Stretch="Uniform"
                                                      StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                                      Width="18" Height="18"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="Syntax Executor" Foreground="{StaticResource BrushPrimary}"
                                                           FontSize="16" FontWeight="SemiBold" Margin="0,0,0,3"/>
                                                <TextBlock Text="Version 1.0.0  ·  External Execution Engine  ·  ScriptBlox Ready"
                                                           Foreground="{StaticResource BrushDim}" FontSize="11"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <!-- Quick stats grid -->
                                    <Grid Margin="0,0,0,16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition/>
                                            <ColumnDefinition/>
                                            <ColumnDefinition/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Background="#111827" BorderBrush="#1E2A45"
                                                BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,6,0">
                                            <StackPanel>
                                                <TextBlock Text="API Scripts" Foreground="{StaticResource BrushDim}"
                                                           FontSize="10"/>
                                                <TextBlock x:Name="DashScriptCount" Text="0" 
                                                           Foreground="{StaticResource BrushAccent}"
                                                           FontSize="22" FontWeight="Bold" Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Grid.Column="1" Background="#111827" BorderBrush="#1E2A45"
                                                BorderThickness="1" CornerRadius="10" Padding="16" Margin="3,0">
                                            <StackPanel>
                                                <TextBlock Text="Status" Foreground="{StaticResource BrushDim}"
                                                           FontSize="10"/>
                                                <TextBlock x:Name="DashStatus" Text="Ready"
                                                           Foreground="{StaticResource BrushGreen}"
                                                           FontSize="22" FontWeight="Bold" Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Grid.Column="2" Background="#111827" BorderBrush="#1E2A45"
                                                BorderThickness="1" CornerRadius="10" Padding="16" Margin="6,0,0,0">
                                            <StackPanel>
                                                <TextBlock Text="Version" Foreground="{StaticResource BrushDim}"
                                                           FontSize="10"/>
                                                <TextBlock Text="1.0.0"
                                                           Foreground="{StaticResource BrushPurple}"
                                                           FontSize="22" FontWeight="Bold" Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <!-- Quick actions -->
                                    <Border Background="#111827" BorderBrush="#1E2A45"
                                            BorderThickness="1" CornerRadius="12" Padding="22,18">
                                        <StackPanel>
                                            <TextBlock Text="Quick Actions" Foreground="{StaticResource BrushSecondary}"
                                                       FontSize="13" FontWeight="SemiBold" Margin="0,0,0,14"/>
                                            <StackPanel Orientation="Horizontal">
                                                <Button Style="{StaticResource BtnExecute}" Height="34"
                                                        Click="Tab_Editor_Quick">
                                                    <TextBlock Text="Open Editor" Margin="4,0"/>
                                                </Button>
                                                <Button Style="{StaticResource BtnAttach}" Height="34"
                                                        Click="Attach_Click">
                                                    <TextBlock Text="Quick Attach" Margin="4,0"/>
                                                </Button>
                                                <Button Style="{StaticResource ToolBtn}" Height="34"
                                                        Click="Tab_ScriptHub_Quick">
                                                    <TextBlock Text="Browse Scripts" Margin="4,0"/>
                                                </Button>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>

                        <!-- ================================================ -->
                        <!--  SCRIPTHUB / SCRIPTBLOX PAGE                       -->
                        <!-- ================================================ -->
                        <Grid x:Name="ViewScriptHub" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="55"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Background="#0B1020"
                                    BorderBrush="#1A2235" BorderThickness="0,0,0,1"
                                    Padding="20,0">
                                <Grid>
                                    <TextBlock Text="ScriptBlox" Foreground="{StaticResource BrushPrimary}"
                                               FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                                VerticalAlignment="Center">
                                        <Button Style="{StaticResource ToolBtn}" Height="30"
                                                Click="ScriptBlox_Refresh" Padding="10,0">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Data="M 2,8 A 6,6 0 1,1 14,8 M 14,2 L 14,8 L 8,8"
                                                      Stroke="{StaticResource BrushSecondary}" StrokeThickness="1.5"
                                                      Fill="Transparent" Stretch="Uniform" Width="12" Height="12"
                                                      StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                                <TextBlock Text="Refresh" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Search / Filter Bar -->
                            <Border Grid.Row="1" Background="#0D1220"
                                    BorderBrush="#1A2235" BorderThickness="0,0,0,1"
                                    Padding="16,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Background="#0A0E1A" BorderBrush="#1E2A45"
                                            BorderThickness="1" CornerRadius="8" Padding="10,6"
                                            Height="32">
                                        <Grid>
                                            <TextBlock Text="Search ScriptBlox scripts..." IsHitTestVisible="False"
                                                       Foreground="{StaticResource BrushMuted}" FontSize="11"
                                                       VerticalAlignment="Center" Visibility="{Binding ElementName=SearchBox, Path=Text.IsEmpty, Converter={x:Null}}"/>
                                            <TextBox x:Name="SearchBox" Background="Transparent"
                                                     BorderThickness="0" Foreground="{StaticResource BrushPrimary}"
                                                     FontSize="11" VerticalAlignment="Center"
                                                     Padding="0" TextChanged="SearchBox_TextChanged"/>
                                        </Grid>
                                    </Border>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="10,0,0,0">
                                        <Button x:Name="BtnLocalScripts" Style="{StaticResource ToolBtn}" Height="32"
                                                Click="ShowLocalScripts" Padding="10,0">
                                            <TextBlock Text="Local" VerticalAlignment="Center" FontSize="11"/>
                                        </Button>
                                        <Button x:Name="BtnBloxScripts" Style="{StaticResource BtnExecute}" Height="32"
                                                Click="ShowBloxScripts" Padding="10,0">
                                            <TextBlock Text="ScriptBlox" VerticalAlignment="Center" FontSize="11"
                                                       Foreground="#0A0E1A"/>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Script List -->
                            <ScrollViewer Grid.Row="2" Padding="16,12"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled"
                                          Style="{StaticResource NeonScrollViewer}">
                                <StackPanel>
                                    <!-- Local Scripts section -->
                                    <StackPanel x:Name="LocalScriptsPanel" Visibility="Visible">
                                        <TextBlock Text="LOCAL SCRIPTS" Foreground="{StaticResource BrushDim}"
                                                   FontSize="10" Margin="4,0,0,10"/>
                                        <ItemsControl x:Name="ScriptHubList">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Style="{StaticResource HubCard}">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <Border Grid.Column="0" Width="32" Height="32"
                                                                    CornerRadius="6" Background="#0D1220"
                                                                    BorderBrush="#1E2A45" BorderThickness="1"
                                                                    Margin="0,0,10,0" VerticalAlignment="Center">
                                                                <Path Data="M 2,3 L 14,3 M 2,7 L 14,7 M 2,11 L 14,11 M 2,15 L 14,15"
                                                                      Stroke="{StaticResource BrushAccent}" StrokeThickness="1.2"
                                                                      Stretch="Uniform" Width="12" Height="12"
                                                                      StrokeEndLineCap="Round"
                                                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>
                                                            <TextBlock Grid.Column="1" Text="{Binding Name}"
                                                                       Foreground="{StaticResource BrushSecondary}"
                                                                       FontSize="12" VerticalAlignment="Center"/>
                                                            <StackPanel Grid.Column="2" Orientation="Horizontal">
                                                                <Button Style="{StaticResource ToolBtn}" Content="Run"
                                                                        Click="ExecuteScriptHub_Click" Tag="{Binding FullPath}"
                                                                        Margin="0,0,4,0" FontSize="11"/>
                                                                <Button Style="{StaticResource ToolBtn}" Content="Copy"
                                                                        Click="CopyScriptHub_Click" Tag="{Binding FullPath}"
                                                                        Margin="0,0,4,0" FontSize="11"/>
                                                                <Button Style="{StaticResource ToolBtn}" Content="×"
                                                                        Click="DeleteScriptHub_Click" Tag="{Binding FullPath}"
                                                                        FontSize="11" Padding="6,0"/>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>

                                    <!-- ScriptBlox section -->
                                    <StackPanel x:Name="BloxScriptsPanel" Visibility="Collapsed">
                                        <TextBlock Text="SCRIPTBLOX.COM" Foreground="{StaticResource BrushAccent}"
                                                   FontSize="10" Margin="4,0,0,10"/>
                                        <ItemsControl x:Name="BloxScriptsListView">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Style="{StaticResource BloxCard}">
                                                        <Grid>
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="Auto"/>
                                                                <RowDefinition Height="Auto"/>
                                                            </Grid.RowDefinitions>
                                                            <Grid Grid.Row="0" Margin="0,0,0,8">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>
                                                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                                                    <Border Width="28" Height="28" CornerRadius="6"
                                                                            Background="#0D1220" BorderBrush="#2D3F66"
                                                                            BorderThickness="1" VerticalAlignment="Center">
                                                                        <Path Data="M 2,3 L 14,3 M 2,7 L 14,7 M 2,11 L 14,11 M 2,15 L 14,15"
                                                                              Stroke="{StaticResource BrushAccent}" StrokeThickness="1.2"
                                                                              Stretch="Uniform" Width="12" Height="12"
                                                                              StrokeEndLineCap="Round"
                                                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                    </Border>
                                                                    <TextBlock Text="{Binding Title}" 
                                                                               Foreground="{StaticResource BrushPrimary}"
                                                                               FontSize="13" FontWeight="SemiBold"
                                                                               VerticalAlignment="Center"/>
                                                                </StackPanel>
                                                                <StackPanel Grid.Column="1" Orientation="Horizontal"
                                                                            VerticalAlignment="Center">
                                                                    <Border Background="#1A2235" CornerRadius="4" Padding="6,2">
                                                                        <TextBlock Foreground="{StaticResource BrushAccent}"
                                                                                   FontSize="9" FontWeight="Bold">
                                                                            <Run Text="{Binding Views}"/>
                                                                        </TextBlock>
                                                                    </Border>
                                                                </StackPanel>
                                                            </Grid>
                                                            <Grid Grid.Row="1">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Grid.Column="0" Text="{Binding Description}"
                                                                           Foreground="{StaticResource BrushDim}"
                                                                           FontSize="10.5"
                                                                           TextTrimming="CharacterEllipsis"
                                                                           MaxHeight="32" LineHeight="16"
                                                                           VerticalAlignment="Center"/>
                                                                <StackPanel Grid.Column="1" Orientation="Horizontal"
                                                                            Margin="10,0,0,0"
                                                                            VerticalAlignment="Center">
                                                                    <Button Style="{StaticResource BtnExecute}"
                                                                            Content="Load" Padding="10,0" Height="28"
                                                                            Click="BloxLoad_Click"
                                                                            Tag="{Binding ScriptId}" FontSize="10"/>
                                                                    <Button Style="{StaticResource ToolBtn}"
                                                                            Content="Copy" Padding="10,0" Height="28"
                                                                            Click="BloxCopy_Click"
                                                                            Tag="{Binding ScriptId}" FontSize="10"/>
                                                                </StackPanel>
                                                            </Grid>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>

                        <!-- ================================================ -->
                        <!--  CLIENT MANAGER PAGE                              -->
                        <!-- ================================================ -->
                        <Grid x:Name="ViewClients" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="55"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Background="#0B1020"
                                    BorderBrush="#1A2235" BorderThickness="0,0,0,1"
                                    Padding="20,0">
                                <TextBlock Text="Client Manager" Foreground="{StaticResource BrushPrimary}"
                                           FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
                            </Border>
                            <ScrollViewer Grid.Row="1" Padding="20,16"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled"
                                          Style="{StaticResource NeonScrollViewer}">
                                <StackPanel>
                                    <!-- Client card with glass effect -->
                                    <Border Background="#111827" BorderBrush="#1E2A45"
                                            BorderThickness="1" CornerRadius="12" Padding="24,22"
                                            Width="340" HorizontalAlignment="Left">
                                        <Border.Effect>
                                            <DropShadowEffect Color="Black" BlurRadius="20" ShadowDepth="4" Opacity="0.5" Direction="270"/>
                                        </Border.Effect>
                                        <StackPanel>
                                            <!-- Avatar with glow ring -->
                                            <Border Width="72" Height="72" CornerRadius="36"
                                                    Background="#0D1220" Margin="0,0,0,16"
                                                    HorizontalAlignment="Center" ClipToBounds="True"
                                                    BorderBrush="#1E2A45" BorderThickness="2">
                                                <Border.Effect>
                                                    <DropShadowEffect Color="#00E5FF" BlurRadius="12" ShadowDepth="0" Opacity="0"/>
                                                </Border.Effect>
                                                <Image x:Name="ClientAvatarImage" Stretch="UniformToFill"/>
                                            </Border>

                                            <TextBlock x:Name="ClientAccountName" Text="Not Connected"
                                                       TextAlignment="Center" FontSize="17"
                                                       Foreground="{StaticResource BrushPrimary}"
                                                       FontWeight="SemiBold" Margin="0,0,0,4"/>
                                            <TextBlock x:Name="ClientPidText" Text="PID: —  ·  Place: —"
                                                       TextAlignment="Center" FontSize="10.5"
                                                       Foreground="{StaticResource BrushDim}"
                                                       Margin="0,0,0,18"/>

                                            <!-- Status badge -->
                                            <Border x:Name="ClientBadgeBg" Background="#111827"
                                                    BorderBrush="#1E2A45" BorderThickness="1"
                                                    CornerRadius="20" Padding="16,6"
                                                    HorizontalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <Ellipse x:Name="ClientStatusDot" Width="5" Height="5"
                                                             Fill="{StaticResource BrushDim}" VerticalAlignment="Center"/>
                                                    <TextBlock x:Name="ClientStatusBadge" Text="DISCONNECTED"
                                                               FontSize="10" FontWeight="Bold"
                                                               Foreground="{StaticResource BrushDim}"/>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>

                        <!-- ================================================ -->
                        <!--  SETTINGS PAGE                                    -->
                        <!-- ================================================ -->
                        <Grid x:Name="ViewSettings" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="55"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Background="#0B1020"
                                    BorderBrush="#1A2235" BorderThickness="0,0,0,1"
                                    Padding="20,0">
                                <TextBlock Text="Settings" Foreground="{StaticResource BrushPrimary}"
                                           FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
                            </Border>
                            <ScrollViewer Grid.Row="1" Padding="20,16"
                                          VerticalScrollBarVisibility="Auto"
                                          Style="{StaticResource NeonScrollViewer}">
                                <StackPanel Width="420" HorizontalAlignment="Left">
                                    <!-- Developer Controls -->
                                    <Border Background="#111827" BorderBrush="#1E2A45"
                                            BorderThickness="1" CornerRadius="12" Padding="22,18"
                                            Margin="0,0,0,12">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                                <Path Data="M 8,5 A 3,3 0 1,0 8,11 A 3,3 0 1,0 8,5 Z M 8,0 L 8,3 M 8,13 L 8,16 M 0,8 L 3,8 M 13,8 L 16,8 M 2.3,2.3 L 4.4,4.4 M 11.6,11.6 L 13.7,13.7 M 13.7,2.3 L 11.6,4.4 M 4.4,11.6 L 2.3,13.7"
                                                      Stroke="{StaticResource BrushSecondary}" StrokeThickness="1.5"
                                                      Stretch="Uniform" Width="14" Height="14"
                                                      StrokeEndLineCap="Round" Margin="0,0,10,0"/>
                                                <TextBlock Text="Developer" Foreground="{StaticResource BrushSecondary}"
                                                           FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <CheckBox Foreground="{StaticResource BrushDim}" FontSize="12"
                                                       Checked="ToggleConsole_Checked"
                                                       Unchecked="ToggleConsole_Unchecked"
                                                       Cursor="Hand" Margin="0,0,0,6">
                                                <CheckBox.Content>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="Debug Console" VerticalAlignment="Center"/>
                                                        <TextBlock Text="(stdout)" Foreground="{StaticResource BrushMuted}"
                                                                   FontSize="10" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </CheckBox.Content>
                                            </CheckBox>
                                        </StackPanel>
                                    </Border>

                                    <!-- About -->
                                    <Border Background="#111827" BorderBrush="#1E2A45"
                                            BorderThickness="1" CornerRadius="12" Padding="22,18">
                                        <StackPanel>
                                            <TextBlock Text="About" Foreground="{StaticResource BrushSecondary}"
                                                       FontWeight="SemiBold" FontSize="13" Margin="0,0,0,12"/>
                                            <TextBlock Foreground="{StaticResource BrushDim}" FontSize="11">
                                                    <Run Text="Syntax Executor v1.0.0"/>
                                                    <LineBreak/>
                                                    <Run Text="Electron-like WPF C# + C++ Core"/>
                                                    <LineBreak/>
                                                    <Run Text="ScriptBlox.com Integration • External Execution Engine"/>
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>

                        <!-- ================================================ -->
                        <!--  LOADING OVERLAY                                  -->
                        <!-- ================================================ -->
                        <Border x:Name="LoadingOverlay" Visibility="Collapsed"
                                Background="#0A0E1A" Opacity="0.85"
                                Panel.ZIndex="50">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Border Width="40" Height="40" CornerRadius="20"
                                        BorderBrush="{StaticResource BrushAccent}"
                                        BorderThickness="2"
                                        Background="Transparent">
                                    <Border.Triggers>
                                        <EventTrigger RoutedEvent="Border.Loaded">
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                     From="0.3" To="1" Duration="0:0:1"
                                                                     AutoReverse="True" RepeatBehavior="Forever"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                    </Border.Triggers>
                                </Border>
                                <TextBlock x:Name="LoadingText" Text="Loading..."
                                           Foreground="{StaticResource BrushAccent}"
                                           FontSize="12" FontWeight="SemiBold"
                                           Margin="0,12,0,0" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- ================================================ -->
                        <!--  NOTIFICATION TOAST                                -->
                        <!-- ================================================ -->
                        <Border x:Name="NotificationBox" Visibility="Collapsed"
                                Background="#111827" BorderBrush="#2D3F66"
                                BorderThickness="1" CornerRadius="10"
                                Padding="14,10" HorizontalAlignment="Right"
                                VerticalAlignment="Bottom" Margin="0,0,16,40"
                                Panel.ZIndex="99" MinWidth="200">
                            <Border.Effect>
                                <DropShadowEffect Color="Black" BlurRadius="16" ShadowDepth="4" Opacity="0.6"/>
                            </Border.Effect>
                            <StackPanel Orientation="Horizontal">
                                <Path x:Name="NotificationIcon" Width="16" Height="16"
                                      Stretch="Uniform" StrokeThickness="1.8"
                                      Fill="Transparent" VerticalAlignment="Center"/>
                                <TextBlock x:Name="NotificationText" Foreground="{StaticResource BrushSecondary}"
                                           FontSize="11.5" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                    </Grid><!-- /page container -->
                </Grid><!-- /main column -->
            </Grid><!-- /root grid -->
        </Border><!-- /inner border -->
    </Border><!-- /outer shadow border -->
</Window>